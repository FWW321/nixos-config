#!/usr/bin/env bash
# flake 锁一致性探针:提交触及 flake 三件套时,单主机全量求值拦脱节。
# 背景:2026-09-13 open-design 迁 sources 登记表后锁未 reconcile,
# inputs.open-design 求值 missing 10 天无人察觉(详见仓库根 AGENTS.md「锁纪律」)。
# 主机固定 FWW-Desktop(主工作站;出现更轻量的探针主机时可替换)。
set -euo pipefail

changed=$(git diff --cached --name-only HEAD -- flake.nix sources/flake.nix flake.lock)
if [ -n "$changed" ]; then
  echo "[pre-commit] flake 三件套有变,跑求值探针(约 1-2 分钟)..."
  nix eval \
    .#nixosConfigurations.FWW-Desktop.config.system.build.toplevel.drvPath >/dev/null
  echo "[pre-commit] 探针通过"
fi
